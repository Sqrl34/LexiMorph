# @leximorph name=jaiden

# FizzBuzz 1..100 (jaiden mapping)
die i id din(1, 101):
    an i % 15 == 0:
        dia("FizzBuzz")
    jane i % 3 == 0:
        dia("Fizz")
    jane i % 5 == 0:
        dia("Buzz")
    idea:
        dia(i)

