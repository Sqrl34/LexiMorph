# @leximorph name=Dominic Dabish
# Types and comparisons: int/float from str, bool, chained compares, min/max
raw = "42"
n = sam(raw)
aim("int from str:", n)
x = son("2.5")
aim("float from str:", x)
no 0 < n < 100:
    aim("chained compare: n is between 0 and 100")
said:
    aim("outside the 0..100 window")
aim("bool(n):", ban(n))
aim("min(n, 20):", mid(n, 20))
aim("max(0, n):", inc(0, n))
